#include <stdio.h>
#define INF 9999

int main() {
    int n, i, j, k, updated;

    printf("Enter number of routers: ");
    scanf("%d", &n);

    int cost[n][n], dist[n][n], nextHop[n][n];
    printf("Enter cost matrix (-1 for no link):\n");

    for (i=0; i<n; i++) {
        for (j=0; j<n; j++) {
            scanf("%d", &cost[i][j]);

            if (cost[i][j]==-1)
                cost[i][j]=INF;

            dist[i][j] = cost[i][j];

            if (i!=j && cost[i][j]!=INF)
                nextHop[i][j] = j;
            else
                nextHop[i][j] = -1;
        }
    }

    // Distance Vector Routing
    do {
        updated = 0;
        for (i=0; i<n; i++) {
            for (j=0; j<n; j++) {
                for (k=0; k<n; k++) {
                    if (dist[i][k] != INF && dist[k][j] != INF && dist[i][j] > dist[i][k] + dist[k][j]) {
                        dist[i][j] = dist[i][k] + dist[k][j];
                        nextHop[i][j] = nextHop[i][k];
                        updated = 1;
                    }
                }
            }
        }
    } while (updated);

    // Display routing tables
    for (i=0; i<n; i++) {
        printf("\nRouting table for Router %d:\n", i);
        printf("Destination\tCost\tNext Hop\n");

        for (j=0; j<n; j++) {
            printf("%d\t\t", j);

            if (dist[i][j]==INF)
                printf("INF\t-\n");
            else if (i==j)
                printf("0\t-\n");
            else
                printf("%d\t%d\n", dist[i][j], nextHop[i][j]);
        }
    }

    return 0;
}

//cost[][] stores the initial link costs.
//dist[][] stores the minimum distance between routers.
//nextHop[][] stores the next router to use.
